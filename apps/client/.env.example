# =============================================================================
# AssessorAI — Variáveis de ambiente
# =============================================================================
# Copie este arquivo para `.env.local` e preencha com os valores reais.
# NUNCA commite o arquivo `.env.local` com valores reais.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend externo (AssessorAI API)
# URL base da API do backend. Troque pela URL do seu ambiente.
# -----------------------------------------------------------------------------
BACKEND_ASSESSORAI_URL=https://api.seu-backend.com

# -----------------------------------------------------------------------------
# Auth.js / NextAuth
# Gere um secret seguro com: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=seu_secret_aqui

# URL pública da aplicação (usada pelo NextAuth para callbacks de autenticação).
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google Places API (autocomplete de endereços)
# Crie uma chave em: https://console.cloud.google.com/
# Habilite a API: "Places API"
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=sua_chave_google_places_aqui

# -----------------------------------------------------------------------------
# Google Tag Manager / Google Ads (Analytics) — opcional
# Deixe em branco para desabilitar.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_TAG_ID=

# -----------------------------------------------------------------------------
# Facebook Pixel (Analytics) — opcional
# Deixe em branco para desabilitar.
# -----------------------------------------------------------------------------
NEXT_FACEBOOK_PIXEL_ID=

# -----------------------------------------------------------------------------
# WhatsApp de suporte — opcional
# Número no formato internacional sem "+", ex: 5511999999999
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá! Cheguei aqui pela plataforma AssessorAI e gostaria de uma ajuda, por favor.
NEXT_PUBLIC_LINK_PRECISANDO_AJUDA=https://wa.me/5511999999999?text=Olá! Cheguei aqui pela plataforma AssessorAI e gostaria de uma ajuda, por favor.

# -----------------------------------------------------------------------------
# Localização / Idioma
# -----------------------------------------------------------------------------
NEXT_PUBLIC_LOCALE=pt-BR
NEXT_PUBLIC_LOCALE_CODE=BR

# ====================
# DATABASE
# ====================
# SQLite para desenvolvimento local, PostgreSQL para produção
DATABASE_URL=sqlite:///./assessorai.db
# Para PostgreSQL, use: postgresql://user:password@hostname:port/dbname
# Opções avançadas (opcional): DATABASE_USER, DATABASE_PASSWORD, DATABASE_HOSTNAME, DATABASE_PORT, DATABASE_NAME

# Exibir queries SQL no console (útil para debug)
SQL_ECHO=False

# ====================
# OPENAI / EMBEDDINGS
# ====================
# Obrigatório: chave da API OpenAI para embeddings e LLM
OPENAI_API_KEY=

# Opcional: configurações de embeddings (valores padrão funcionam bem)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_TIMEOUT=60

# ====================
# GOOGLE CLOUD STORAGE
# ====================
# Credenciais do Google Cloud (escolha UMA das opções abaixo)
GOOGLE_APPLICATION_CREDENTIALS=
# OU para ambientes containerizados (base64 do JSON de credenciais):
# GOOGLE_APPLICATION_BASE64=

# Nome do bucket GCS para armazenamento de arquivos
GCS_BUCKET_NAME=

# ====================
# EMAIL (SendGrid)
# ====================
SENDGRID_API_KEY=
SENDGRID_SENDER_EMAIL=
SENDGRID_SENDER_NAME=AssessorAI

# ====================
# APLICAÇÃO
# ====================
# URL do frontend para links em emails e redirects
FRONTEND_URL=http://localhost:8000

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8000

# Modo debug (True/False) - ativa logs detalhados
DEBUG=False

# Expiração do token JWT em minutos (padrão: 30)
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ====================
# DEPLOY / MIGRATIONS
# ====================
# Controla o comportamento das migrações no deploy
# DB_REFRESH_MODE=incremental
# Opções: incremental (aplica novas migrations), rebuild/full/wipe (recria todo banco)

# ====================
# ADVANCED / PERFORMANCE (Opcional)
# ====================
# Tamanho máximo para upload de arquivo (bytes, padrão: 50MB)
# MAX_UPLOAD_FILE_SIZE=52428800

# Paginação padrão para listagens (limite e offset)
# Endpoints afetados: /user/, /mandatos/, /mandatos/{id}/users, /mandatos/{id}/objetivos
# Limite máximo: 500 itens por página (padrão: 50)
# DEFAULT_PAGINATION_LIMIT=50

# Tamanho máximo de arquivo para embedding (bytes, padrão: 10MB)
# MAX_EMBEDDING_FILE_SIZE=10000000

# Batch size para requisições de embedding à API OpenAI (padrão: 100)
# EMBEDDING_BATCH_SIZE=100

# Batch size unificado para importação vetorial e bulk inserts no PostgreSQL (padrão: 200)
# Ajustado para prevenir OOM no PostgreSQL com grandes lotes (200 docs ≈ 1.2MB por query)
# VECTOR_BATCH_SIZE=200

# Número de probes para busca vetorial (auto-calculado se omitido)
# VECTOR_SEARCH_PROBES=10

# TTL do cache de estatísticas vetoriais em segundos (padrão: 300 = 5 minutos)
# VECTOR_STATS_CACHE_TTL=300

# ====================
# STREAMLIT CLIENT (apenas para client/)
# ====================
# URL da API backend para o console admin Streamlit
# ASSESSORAI_API_URL=http://localhost:8000

# Configurações de importação vetorial
# CHUNK_TOKEN_MODEL=text-embedding-ada-002
